# ==============================================
# docsfeed MCP - Environment Configuration Template
# ==============================================

# Application Environment
NODE_ENV=development
PORT=4000

# Primary Database (PostgreSQL with pgvector)
# Works out-of-the-box with Serverless Postgres (Neon / Supabase) or local/Docker Postgres:
# Examples:
#   Neon / Supabase:  "postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   Local / Docker:   "postgresql://postgres:postgres@localhost:5432/docsfeed?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docsfeed?schema=public"

# Background Job Queue (pg-boss uses the same PostgreSQL instance - zero extra services/Redis needed!)

# Authentication (JWT Secret for Dashboard)
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Embedding Providers Configuration
EMBEDDING_PROVIDER="local" # "local" or "openai"
LOCAL_EMBEDDING_URL="http://localhost:11434"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Web Dashboard (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"
